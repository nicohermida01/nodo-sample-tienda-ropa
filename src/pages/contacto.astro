---
import InfoLayout from '../layouts/InfoLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../config/site';

const { contact, social, showroom } = site;
const channels = [
  {
    icon: 'whatsapp' as const,
    label: 'WhatsApp',
    value: contact.whatsapp.display,
    href: `https://wa.me/${contact.whatsapp.e164}`,
    external: true,
  },
  { icon: 'instagram' as const, label: 'Instagram', value: social.instagram.handle, href: social.instagram.url, external: true },
  { icon: 'mail' as const, label: 'Email', value: contact.email, href: `mailto:${contact.email}`, external: false },
];
---

<InfoLayout
  title="Contacto y showroom"
  description={`Escribinos o visitá el showroom de ${site.brand.name} en ${showroom.city}, con cita previa.`}
  lead="Respondemos de lunes a viernes, de 10 a 18. Por WhatsApp es más rápido."
>
  <ul class="not-prose mt-2 divide-y divide-line border-y border-line">
    {
      channels.map((c) => (
        <li>
          <a
            href={c.href}
            class="flex min-h-16 items-center gap-4 py-3"
            target={c.external ? '_blank' : undefined}
            rel={c.external ? 'noopener noreferrer' : undefined}
          >
            <Icon name={c.icon} size={22} />
            <span class="flex-1">
              <span class="block text-[0.75rem] text-ink-muted">{c.label}</span>
              <span class="link-quiet">{c.value}</span>
            </span>
            <Icon name="arrow-right" size={18} />
          </a>
        </li>
      ))
    }
  </ul>

  <h2>Showroom</h2>
  <p>
    <strong>{showroom.address}, {showroom.city}</strong><br />
    {showroom.note}
  </p>
  <p>
    En el showroom podés probarte toda la colección, retirar compras online y hacer cambios.
    {showroom.byAppointment && ' Pedí tu cita por WhatsApp indicando día y franja horaria.'}
  </p>
  <a href={`https://wa.me/${contact.whatsapp.e164}?text=${encodeURIComponent('Hola, quiero coordinar una visita al showroom.')}`} class="btn btn-primary mt-2" target="_blank" rel="noopener noreferrer">
    Pedir cita por WhatsApp
  </a>
</InfoLayout>
