---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import { Picture } from 'astro:assets';
import { getProductCollections, getProducts } from '../../lib/products';

const collections = await getProductCollections();
const products = await getProducts();
const countFor = (id: string) => products.filter((p) => p.data.collection.id === id).length;
---

<BaseLayout title="Colecciones" description="Las colecciones de TRAMA Estudio: temporada actual y básicos permanentes.">
  <PageIntro
    title="Colecciones"
    lead="Una colección por temporada y una línea de básicos que no cambia."
    breadcrumb={[
      { label: 'Inicio', href: '/' },
      { label: 'Colecciones', href: '/colecciones' },
    ]}
  />
  <ul class="bleed grid gap-2 pb-16 md:grid-cols-2 lg:gap-3 lg:pb-24">
    {
      collections.map((c, i) => (
        <li class="reveal" style={`--i:${i}`}>
          <a href={`/colecciones/${c.data.slug}`} class="group block">
            <div class="collection-cover">
              <Picture
                src={c.data.cover.src}
                alt={c.data.cover.alt}
                widths={[480, 720, 960, 1200]}
                sizes="(min-width: 768px) 50vw, 100vw"
                formats={['avif', 'webp']}
                loading={i < 2 ? 'eager' : 'lazy'}
                class="h-full w-full object-cover"
              />
            </div>
            <div class="flex items-baseline justify-between gap-4 px-0.5 pt-4">
              <h2 class="text-[1.25rem] font-semibold tracking-[-0.01em]">
                <span class="link-quiet">{c.data.name}</span>
              </h2>
              <span class="text-[0.8125rem] text-ink-muted">{countFor(c.id)} prendas</span>
            </div>
            <p class="mt-1 max-w-[52ch] px-0.5 text-ink-muted">{c.data.tagline}</p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .collection-cover {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface);
  }
</style>
