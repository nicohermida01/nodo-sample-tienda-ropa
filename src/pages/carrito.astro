---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import Icon from '../components/ui/Icon.astro';
import CartLineTemplate from '../components/cart/CartLineTemplate.astro';
import { site } from '../config/site';

const { commerce } = site;
---

<BaseLayout title="Carrito" description="Tu carrito en TRAMA Estudio." noindex>
  <PageIntro
    title="Tu carrito"
    align="start"
    breadcrumb={[
      { label: 'Inicio', href: '/' },
      { label: 'Carrito', href: '/carrito' },
    ]}
  />

  <div class="shell pb-20 lg:pb-28" data-cart-page data-cart-root>
    <noscript><p class="py-8">Para ver tu carrito necesitás tener JavaScript activado.</p></noscript>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_26rem] lg:gap-16" data-cart-filled hidden>
      <section aria-labelledby="lines-title">
        <h2 id="lines-title" class="sr-only">Productos</h2>
        <CartLineTemplate />
        <ul class="border-t border-line" data-page-lines></ul>
        <a href="/tienda" class="mt-6 inline-flex min-h-11 items-center gap-2 text-[0.8125rem]">
          <span class="link">Seguir comprando</span>
        </a>
      </section>

      <div class="space-y-8">
        <section class="bg-surface p-6" aria-labelledby="summary-title">
          <h2 id="summary-title" class="label" tabindex="-1" data-cart-focus>Resumen</h2>
          <dl class="mt-4 space-y-2 text-[0.875rem]">
            <div class="flex justify-between">
              <dt>Subtotal</dt>
              <dd class="tabular-nums" data-sum-subtotal></dd>
            </div>
            <div class="flex justify-between">
              <dt>Envío</dt>
              <dd data-sum-shipping></dd>
            </div>
            <div class="flex justify-between border-t border-line pt-3 text-[1rem] font-semibold">
              <dt>Total</dt>
              <dd class="tabular-nums" data-sum-total></dd>
            </div>
          </dl>
          <p class="mt-1 text-[0.75rem] text-ink-muted">IVA incluido.</p>
          <ul class="mt-4 space-y-2 border-t border-line pt-4 text-[0.8125rem]">
            <li class="flex items-start gap-2">
              <Icon name="check" size={18} class="shrink-0" />
              <span>
                <strong class="font-semibold tabular-nums" data-sum-transfer></strong> pagando por transferencia
                ({Math.round(commerce.transferDiscount * 100)}% off)
              </span>
            </li>
            <li class="flex items-start gap-2">
              <Icon name="card" size={18} class="shrink-0" />
              <span data-sum-installments></span>
            </li>
            <li class="flex items-start gap-2">
              <Icon name="truck" size={18} class="shrink-0" />
              <span data-sum-shipping-note></span>
            </li>
          </ul>
        </section>

        <section aria-labelledby="checkout-title">
          <h2 id="checkout-title" class="text-[1.25rem] font-semibold tracking-[-0.01em]">Finalizar compra</h2>
          <div class="demo-note mt-4" role="note">
            <p class="font-semibold">Checkout de demostración</p>
            <p class="mt-1">
              Esta tienda es una demo: no vas a pagar nada y no te pedimos datos de tarjeta ni de pago.
              Al confirmar, simulamos el pedido y vaciamos el carrito. Una tienda real se conecta acá a
              su pasarela de pago o recibe el pedido por WhatsApp.
            </p>
          </div>

          <form class="mt-6 space-y-5" data-checkout novalidate>
            <div>
              <label for="co-name" class="label">Nombre y apellido</label>
              <input id="co-name" name="name" class="field mt-2" autocomplete="name" required />
            </div>
            <div>
              <label for="co-email" class="label">Email</label>
              <input id="co-email" name="email" type="email" class="field mt-2" autocomplete="email" required />
            </div>
            <fieldset>
              <legend class="label">Entrega</legend>
              <div class="mt-2 space-y-2">
                <label class="ship-option">
                  <input type="radio" name="shipping" value="domicilio" checked />
                  <span>
                    <span class="block font-medium">Envío a domicilio</span>
                    <span class="block text-[0.8125rem] text-ink-muted" data-ship-home></span>
                  </span>
                </label>
                <label class="ship-option">
                  <input type="radio" name="shipping" value="showroom" />
                  <span>
                    <span class="block font-medium">Retiro en el showroom</span>
                    <span class="block text-[0.8125rem] text-ink-muted">
                      {site.showroom.address}, {site.showroom.city}. Sin costo, con cita previa.
                    </span>
                  </span>
                </label>
              </div>
            </fieldset>
            <p class="text-[0.8125rem] text-sale" role="alert" data-checkout-error></p>
            <button type="submit" class="btn btn-primary w-full">Confirmar pedido de demostración</button>
          </form>

          <a
            href={`https://wa.me/${site.contact.whatsapp.e164}`}
            class="btn btn-secondary mt-3 w-full"
            target="_blank"
            rel="noopener noreferrer"
            data-whatsapp
          >
            <Icon name="whatsapp" size={18} />
            Enviar pedido por WhatsApp
            <span class="sr-only"> (se abre en una pestaña nueva)</span>
          </a>
        </section>
      </div>
    </div>

    <div class="py-16 text-center" data-cart-empty hidden>
      <Icon name="bag" size={32} class="mx-auto text-ink-muted" />
      <p class="mt-4 text-[1.125rem] font-semibold">Tu carrito está vacío</p>
      <p class="mx-auto mt-2 max-w-sm text-ink-muted">
        Mirá lo nuevo de la temporada o los básicos de siempre.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-2">
        <a href="/novedades" class="btn btn-primary">Ver novedades</a>
        <a href="/tienda" class="btn btn-secondary">Toda la tienda</a>
      </div>
    </div>

    <div class="mx-auto max-w-lg py-16 text-center" data-cart-done hidden tabindex="-1">
      <Icon name="check" size={32} class="mx-auto" />
      <p class="mt-4 text-[1.375rem] font-semibold tracking-[-0.01em]">Pedido de demostración confirmado</p>
      <p class="mt-3 text-ink-muted" data-done-text></p>
      <a href="/tienda" class="btn btn-primary mt-8">Volver a la tienda</a>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    $cartItems,
    $cartSubtotal,
    $freeShippingRemaining,
    clearCart,
    type CartItem,
  } from '../stores/cart';
  import { site, formatPrice } from '../config/site';
  import { onPage } from '../lib/client/lifecycle';
  import { renderLines, bindLineControls } from '../lib/client/cart-lines';

  const { commerce } = site;

  function whatsappUrl(items: readonly CartItem[], subtotal: number) {
    const lines = items.map(
      (i) => `- ${i.quantity} × ${i.name} (${i.color.name}, talle ${i.size}): ${formatPrice(i.price * i.quantity)}`,
    );
    const text = [
      `Hola ${site.brand.name}, quiero hacer este pedido:`,
      ...lines,
      `Subtotal: ${formatPrice(subtotal)}`,
    ].join('\n');
    return `https://wa.me/${site.contact.whatsapp.e164}?text=${encodeURIComponent(text)}`;
  }

  onPage(() => {
    const root = document.querySelector<HTMLElement>('[data-cart-page]');
    if (!root) return;
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const filled = q('[data-cart-filled]');
    const empty = q('[data-cart-empty]');
    const done = q('[data-cart-done]');
    const list = q<HTMLUListElement>('[data-page-lines]');
    const template = q<HTMLTemplateElement>('[data-line-template]');
    const form = q<HTMLFormElement>('[data-checkout]');
    const error = q('[data-checkout-error]');
    const whatsapp = q<HTMLAnchorElement>('[data-whatsapp]');
    let completed = false;

    const set = (sel: string, text: string) => {
      q(sel).textContent = text;
    };

    const render = () => {
      const items = $cartItems.get();
      const subtotal = $cartSubtotal.get();
      const remaining = $freeShippingRemaining.get();
      const pickup = form.querySelector<HTMLInputElement>('input[value="showroom"]')?.checked;
      const freeShipping = remaining === 0;

      filled.hidden = items.length === 0 || completed;
      empty.hidden = items.length > 0 || completed;
      renderLines(list, template, items);

      set('[data-sum-subtotal]', formatPrice(subtotal));
      set('[data-sum-shipping]', pickup || freeShipping ? 'Sin costo' : 'Se calcula con tu código postal');
      set('[data-sum-total]', formatPrice(subtotal));
      set('[data-sum-transfer]', formatPrice(Math.round(subtotal * (1 - commerce.transferDiscount))));
      const { count, interestFree } = commerce.installments;
      set(
        '[data-sum-installments]',
        `${count} cuotas${interestFree ? ' sin interés' : ''} de ${formatPrice(Math.round(subtotal / count))}`,
      );
      set(
        '[data-sum-shipping-note]',
        freeShipping
          ? 'Tu compra tiene envío gratis a todo el país.'
          : `Te faltan ${formatPrice(remaining)} para el envío gratis.`,
      );
      set(
        '[data-ship-home]',
        freeShipping ? 'Gratis. Llega en 3 a 7 días hábiles.' : 'Llega en 3 a 7 días hábiles. El costo depende de tu código postal.',
      );
      whatsapp.href = whatsappUrl(items, subtotal);
    };

    const onSubmit = (event: SubmitEvent) => {
      event.preventDefault();
      const name = form.querySelector<HTMLInputElement>('#co-name')!;
      const email = form.querySelector<HTMLInputElement>('#co-email')!;
      const invalid = [name, email].filter((f) => !f.value.trim() || !f.checkValidity());
      [name, email].forEach((f) => f.toggleAttribute('aria-invalid', invalid.includes(f)));
      if (invalid.length) {
        error.textContent = invalid.includes(name)
          ? 'Completá tu nombre para confirmar el pedido.'
          : 'Revisá el email: tiene que tener el formato nombre@dominio.com.';
        invalid[0].focus();
        return;
      }
      error.textContent = '';
      // Demo only: nothing is sent anywhere.
      completed = true;
      const firstName = name.value.trim().split(/\s+/)[0];
      set(
        '[data-done-text]',
        `Gracias, ${firstName}. Como es una tienda de demostración no se generó ningún pedido real ni se cobró nada. En una tienda real, acá recibirías la confirmación por email.`,
      );
      clearCart();
      done.hidden = false;
      done.focus();
    };

    const unsubscribe = $cartItems.subscribe(render);
    const unbind = bindLineControls(list, () => $cartItems.get());
    form.addEventListener('submit', onSubmit);
    form.addEventListener('change', render);
    return () => {
      unsubscribe();
      unbind();
      form.removeEventListener('submit', onSubmit);
      form.removeEventListener('change', render);
    };
  });
</script>

<style>
  .demo-note {
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-ink);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .ship-option {
    display: flex;
    gap: 0.875rem;
    padding: 1rem;
    border: 1px solid var(--color-line);
    border-radius: 2px;
    cursor: pointer;
    font-size: 0.875rem;
    transition: border-color 200ms var(--ease-out-expo);
  }

  .ship-option:has(input:checked) {
    border-color: var(--color-ink);
  }

  .ship-option input {
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.125rem;
    flex-shrink: 0;
  }

  [aria-invalid] {
    border-color: var(--color-sale);
  }
</style>
