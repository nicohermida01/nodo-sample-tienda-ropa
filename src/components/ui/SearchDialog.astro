---
import { formatPrice } from '../../config/site';
import { getProducts, thumbnail, CATEGORY_LABELS, productHref } from '../../lib/products';
import Icon from './Icon.astro';

const products = await getProducts();
const index = await Promise.all(
  products.map(async (p) => ({
    name: p.data.name,
    href: productHref(p),
    category: CATEGORY_LABELS[p.data.category],
    colors: p.data.colors.map((c) => c.name).join(', '),
    price: formatPrice(p.data.price),
    thumb: (await thumbnail(p, 96)).src,
  })),
);
const categories = [...new Set(products.map((p) => p.data.category))];
---

<dialog
  id="search-dialog"
  class="overlay search-dialog"
  aria-labelledby="search-title"
  data-page-dialog
  data-light-dismiss
>
  <div class="shell py-5 lg:py-8">
    <div class="flex items-center justify-between gap-4">
      <h2 id="search-title" class="label">Buscar</h2>
      <button type="button" class="close-btn" data-close-dialog>
        <Icon name="x" size={22} />
        <span class="sr-only">Cerrar búsqueda</span>
      </button>
    </div>
    <form role="search" class="mt-3" data-search-form>
      <label for="search-input" class="sr-only">Buscar por prenda, categoría o color</label>
      <div class="search-field">
        <Icon name="search" size={22} />
        <input
          id="search-input"
          type="search"
          autocomplete="off"
          placeholder="Buscá por prenda, categoría o color"
          aria-controls="search-results"
          aria-describedby="search-status"
          data-search-input
        />
      </div>
    </form>

    <p id="search-status" class="sr-only" aria-live="polite" data-search-status></p>

    <div class="mt-6" data-search-empty>
      <p class="label text-ink-muted">Categorías</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          categories.map((c) => (
            <li>
              <a class="chip" href={`/tienda?categoria=${c}`}>
                {CATEGORY_LABELS[c]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <ul id="search-results" class="search-results mt-6" data-search-results></ul>
    <p class="mt-6 text-ink-muted" data-search-none hidden>
      No encontramos prendas con esa búsqueda. Probá con otra palabra o mirá <a
        href="/tienda"
        class="link text-ink">toda la tienda</a
      >.
    </p>
  </div>

  <script type="application/json" data-search-index set:html={JSON.stringify(index)} />
</dialog>

<script>
  import { onPage } from '../../lib/client/lifecycle';

  interface Entry {
    name: string;
    href: string;
    category: string;
    colors: string;
    price: string;
    thumb: string;
  }

  const normalize = (s: string) =>
    s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

  onPage(() => {
    const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
    if (!dialog) return;
    const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
    const list = dialog.querySelector<HTMLUListElement>('[data-search-results]')!;
    const empty = dialog.querySelector<HTMLElement>('[data-search-empty]')!;
    const none = dialog.querySelector<HTMLElement>('[data-search-none]')!;
    const status = dialog.querySelector<HTMLElement>('[data-search-status]')!;
    const form = dialog.querySelector<HTMLFormElement>('[data-search-form]')!;
    const raw = dialog.querySelector('[data-search-index]')?.textContent ?? '[]';
    const entries = (JSON.parse(raw) as Entry[]).map((e) => ({
      ...e,
      haystack: normalize(`${e.name} ${e.category} ${e.colors}`),
    }));

    const render = () => {
      const terms = normalize(input.value.trim()).split(/\s+/).filter(Boolean);
      list.replaceChildren();
      empty.hidden = terms.length > 0;
      if (!terms.length) {
        none.hidden = true;
        status.textContent = '';
        return;
      }
      const matches = entries.filter((e) => terms.every((t) => e.haystack.includes(t)));
      none.hidden = matches.length > 0;
      status.textContent =
        matches.length === 1 ? '1 resultado' : `${matches.length} resultados`;
      for (const m of matches) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = m.href;
        a.className = 'search-hit';
        const img = document.createElement('img');
        img.src = m.thumb;
        img.alt = '';
        img.width = 48;
        img.height = 60;
        img.loading = 'lazy';
        const text = document.createElement('span');
        text.className = 'flex flex-col';
        const name = document.createElement('span');
        name.textContent = m.name;
        const meta = document.createElement('span');
        meta.className = 'text-ink-muted text-[0.8125rem]';
        meta.textContent = `${m.category} · ${m.price}`;
        text.append(name, meta);
        a.append(img, text);
        li.append(a);
        list.append(li);
      }
    };

    const onSubmit = (event: SubmitEvent) => {
      event.preventDefault();
      list.querySelector<HTMLAnchorElement>('a')?.click();
    };
    const onOpen = () => {
      if (dialog.open) input.focus();
    };
    const observer = new MutationObserver(onOpen);
    observer.observe(dialog, { attributes: true, attributeFilter: ['open'] });
    input.addEventListener('input', render);
    form.addEventListener('submit', onSubmit);
    return () => {
      observer.disconnect();
      input.removeEventListener('input', render);
      form.removeEventListener('submit', onSubmit);
    };
  });
</script>

<style>
  .search-dialog {
    width: 100%;
    max-height: min(85dvh, 44rem);
    inset: 0 0 auto 0;
    overflow-y: auto;
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--color-ink);
    padding-block: 0.5rem;
  }

  .search-field input {
    flex: 1;
    min-width: 0;
    min-height: 3rem;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    background: transparent;
    outline: none;
  }

  .search-field input::placeholder {
    color: var(--color-ink-muted);
  }

  .search-field:focus-within {
    box-shadow: 0 1px 0 0 var(--color-ink);
  }

  .search-results {
    display: grid;
    gap: 0.25rem;
  }

  @media (min-width: 768px) {
    .search-results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  .search-results :global(.search-hit) {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .search-results :global(.search-hit img) {
    width: 3rem;
    height: 3.75rem;
    object-fit: cover;
    background: var(--color-surface);
  }

  @media (hover: hover) {
    .search-results :global(.search-hit:hover) {
      border-color: var(--color-ink);
    }
  }

  .close-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.75rem;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: no-preference) {
    .search-dialog[open] {
      animation: search-in 400ms var(--ease-out-expo);
    }
    @keyframes search-in {
      from {
        opacity: 0;
        transform: translateY(-16px);
      }
    }
  }
</style>
