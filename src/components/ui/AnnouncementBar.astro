---
import { site } from '../../config/site';

const items = site.copy.announcements;
---

<div class="announce bg-ink text-on-ink" role="region" aria-label="Anuncios de la tienda" tabindex="0">
  <div class="announce-track">
    <ul class="announce-list">
      {items.map((text) => <li>{text}</li>)}
    </ul>
    <ul class="announce-list announce-copy" aria-hidden="true">
      {items.map((text) => <li>{text}</li>)}
    </ul>
  </div>
</div>

<style>
  .announce {
    height: var(--bar-h);
    overflow: hidden;
    display: flex;
    align-items: center;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .announce:focus-visible {
    outline: 2px solid var(--color-on-ink);
    outline-offset: -4px;
  }

  .announce-track {
    display: flex;
    width: max-content;
  }

  .announce-list {
    display: flex;
    flex-shrink: 0;
    gap: 4rem;
    padding-right: 4rem;
    white-space: nowrap;
  }

  .announce-list li {
    display: flex;
    align-items: center;
    gap: 4rem;
  }

  .announce-list li::after {
    content: '';
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.6;
    margin-right: -2rem;
    margin-left: -2rem;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .announce-track {
      animation: marquee 48s linear infinite;
    }
    .announce:hover .announce-track,
    .announce:focus-within .announce-track,
    .announce:focus .announce-track {
      animation-play-state: paused;
    }
  }

  /* Reduced motion: static, manually scrollable list. */
  @media (prefers-reduced-motion: reduce) {
    .announce {
      overflow-x: auto;
      scrollbar-width: none;
    }
    .announce-track {
      margin-inline: auto;
      padding-inline: 1rem;
    }
    .announce-copy {
      display: none;
    }
  }
</style>
