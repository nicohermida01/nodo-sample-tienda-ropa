---
import { site } from '../../config/site';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import SearchDialog from './SearchDialog.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  /** Transparent, light header laid over a full-bleed campaign photo. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
  id="site-header"
  class="site-header"
  data-overlay={overlay ? 'true' : undefined}
  data-solid={overlay ? undefined : 'true'}
>
  <div class="shell header-row">
    <div class="flex items-center gap-1 lg:gap-0">
      <button
        type="button"
        class="icon-btn menu-btn -ml-3"
        data-open-dialog="mobile-menu"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={22} />
        <span class="sr-only">Abrir menú</span>
      </button>
      <Wordmark />
    </div>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {
          site.nav.main.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link link-quiet"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center justify-end -mr-3">
      <button
        type="button"
        class="icon-btn"
        data-open-dialog="search-dialog"
        aria-haspopup="dialog"
        aria-controls="search-dialog"
      >
        <Icon name="search" size={21} />
        <span class="sr-only">Buscar productos</span>
      </button>
      <button type="button" class="icon-btn relative" data-open-cart aria-haspopup="dialog">
        <Icon name="bag" size={21} />
        <span class="sr-only">Abrir carrito,</span>
        <span class="cart-count" data-cart-count hidden aria-hidden="true">0</span>
        <span class="sr-only" data-cart-count-label>sin productos</span>
      </button>
    </div>
  </div>
</header>

<SearchDialog />
<MobileMenu />

<script>
  import { $cartCount, $lastAdded } from '../../stores/cart';
  import { onPage, prefersReducedMotion } from '../../lib/client/lifecycle';

  onPage(() => {
    const header = document.getElementById('site-header');
    if (!header) return;
    const cleanups: (() => void)[] = [];

    if (header.dataset.overlay) {
      const onScroll = () => {
        header.toggleAttribute('data-solid', window.scrollY > 24);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      cleanups.push(() => window.removeEventListener('scroll', onScroll));
    }

    const count = header.querySelector<HTMLElement>('[data-cart-count]');
    const label = header.querySelector<HTMLElement>('[data-cart-count-label]');
    cleanups.push(
      $cartCount.subscribe((n) => {
        if (count) {
          count.textContent = String(n);
          count.hidden = n === 0;
        }
        if (label) label.textContent = n === 1 ? '1 producto' : n ? `${n} productos` : 'sin productos';
      }),
    );
    cleanups.push(
      $lastAdded.listen((item) => {
        if (!item || !count || prefersReducedMotion()) return;
        count.classList.remove('is-bumping');
        void count.offsetWidth;
        count.classList.add('is-bumping');
      }),
    );

    return () => cleanups.forEach((fn) => fn());
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    color: var(--color-ink);
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
    opacity: 0;
    transition: opacity 300ms var(--ease-out-expo);
  }

  .site-header[data-solid]::before {
    opacity: 1;
  }

  .site-header[data-overlay]:not([data-solid]) {
    color: var(--color-on-ink);
  }

  .site-header[data-overlay]:not([data-solid]) :focus-visible {
    outline-color: var(--color-on-ink);
  }

  .site-header[data-overlay] {
    margin-bottom: calc(var(--header-h) * -1);
  }

  .header-row {
    position: relative;
    height: var(--header-h);
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 300ms var(--ease-out-expo);
  }

  @media (min-width: 1024px) {
    .header-row {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
    .icon-btn.menu-btn {
      display: none;
    }
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .nav-link[aria-current='page'] {
    background-size: 100% 1px;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
  }

  .cart-count {
    position: absolute;
    top: 0.3rem;
    right: 0.2rem;
    min-width: 1.125rem;
    height: 1.125rem;
    padding-inline: 0.25rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-on-ink);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1.125rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .site-header[data-overlay]:not([data-solid]) .cart-count {
    background: var(--color-on-ink);
    color: var(--color-ink);
  }

  .cart-count:global(.is-bumping) {
    animation: bump 450ms var(--ease-out-expo);
  }
</style>
