---
import { site } from '../../config/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<a href="/" class:list={['wordmark', className]} aria-label={`${site.brand.name}, inicio`}>
  <span aria-hidden="true">{site.brand.shortName}</span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    margin-right: -0.24em;
    line-height: 1;
  }
</style>
