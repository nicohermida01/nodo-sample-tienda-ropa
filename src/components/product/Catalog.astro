---
import ProductCard from './ProductCard.astro';
import Icon from '../ui/Icon.astro';
import { formatPrice } from '../../config/site';
import { SIZES } from '../../content.config';
import { CATEGORY_LABELS, SORT_OPTIONS, type Category, type Product } from '../../lib/products';

interface Props {
  products: Product[];
}

const { products } = Astro.props;

const categories = [...new Set(products.map((p) => p.data.category))] as Category[];
const sizes = SIZES.filter((s) => products.some((p) => p.data.sizes.some((x) => x.label === s)));
const colors = [
  ...new Map(products.flatMap((p) => p.data.colors).map((c) => [c.name, c])).values(),
];
const step = 5000;
const prices = products.map((p) => p.data.price);
const minPrice = Math.floor(Math.min(...prices) / step) * step;
const maxPrice = Math.ceil(Math.max(...prices) / step) * step;
const countLabel = (n: number) => (n === 1 ? '1 producto' : `${n} productos`);
---

<div class="catalog pb-20 lg:pb-28" data-catalog data-min-price={minPrice} data-max-price={maxPrice}>
  <div class="bleed">
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1" role="group" aria-label="Categorías">
      <button type="button" class="chip" data-category="" aria-pressed="true">Todo</button>
      {
        categories.map((c) => (
          <button type="button" class="chip" data-category={c} aria-pressed="false">
            {CATEGORY_LABELS[c]}
          </button>
        ))
      }
    </div>

    <div class="mt-4 flex items-center justify-between gap-4 border-y border-line py-2">
      <p class="text-[0.8125rem]" aria-live="polite" data-count>{countLabel(products.length)}</p>
      <div class="flex items-center gap-2">
        <button
          type="button"
          class="inline-flex min-h-11 items-center gap-2 px-2 text-[0.8125rem] font-medium lg:hidden"
          data-filters-open
          aria-controls="catalog-filters"
          aria-expanded="false"
        >
          <Icon name="sliders" size={18} />
          Filtrar <span class="tabular-nums" data-active-count></span>
        </button>
        <label class="sort">
          <span class="sr-only">Ordenar por</span>
          <select data-sort>
            {SORT_OPTIONS.map((o) => <option value={o.value}>{o.label}</option>)}
          </select>
          <Icon name="chevron-down" size={16} class="pointer-events-none" />
        </label>
      </div>
    </div>
  </div>

  <div class="bleed mt-6 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-8 2xl:grid-cols-[16rem_minmax(0,1fr)]">
    <div class="filters-backdrop" data-filters-backdrop aria-hidden="true"></div>
    <aside id="catalog-filters" class="filters" aria-labelledby="filters-title" data-filters>
      <div class="filters-head">
        <h2 id="filters-title" class="label">Filtros</h2>
        <button type="button" class="filters-close" data-filters-close>
          <Icon name="x" size={22} />
          <span class="sr-only">Cerrar filtros</span>
        </button>
      </div>

      <form class="filters-body" data-filter-form>
        <fieldset>
          <legend class="label">Talle</legend>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {
              sizes.map((s) => (
                <label class="size-option">
                  <input type="checkbox" name="talle" value={s} />
                  <span>{s}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend class="label">Color</legend>
          <div class="mt-2 grid gap-0.5">
            {
              colors.map((c) => (
                <label class="color-check">
                  <input type="checkbox" name="color" value={c.name} />
                  <span class="dot" style={`--swatch:${c.hex}`} aria-hidden="true" />
                  <span>{c.name}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend class="label">Precio</legend>
          <label for="price-max" class="mt-3 flex items-baseline justify-between text-[0.8125rem]">
            <span>Hasta</span>
            <output for="price-max" class="tabular-nums font-medium" data-price-output>
              {formatPrice(maxPrice)}
            </output>
          </label>
          <input
            id="price-max"
            type="range"
            name="precio"
            min={minPrice}
            max={maxPrice}
            step={step}
            value={maxPrice}
            class="range mt-2"
            data-price
          />
          <div class="mt-1 flex justify-between text-[0.75rem] text-ink-muted tabular-nums">
            <span>{formatPrice(minPrice)}</span>
            <span>{formatPrice(maxPrice)}</span>
          </div>
        </fieldset>

        <button type="reset" class="inline-flex min-h-11 items-center self-start text-[0.8125rem]" data-filters-reset>
          <span class="link">Limpiar filtros</span>
        </button>
      </form>

      <div class="filters-foot lg:hidden">
        <button type="button" class="btn btn-primary w-full" data-filters-apply>
          Ver <span data-apply-count>{countLabel(products.length)}</span>
        </button>
      </div>
    </aside>

    <div>
      <ul class="catalog-grid" data-grid>
        {
          products.map((p, i) => (
            <li
              data-item
              data-index={i}
              data-category={p.data.category}
              data-sizes={p.data.sizes
                .filter((s) => s.inStock)
                .map((s) => s.label)
                .join(',')}
              data-colors={p.data.colors.map((c) => c.name).join('|')}
              data-price={p.data.price}
              data-published={p.data.publishedAt.getTime()}
            >
              <ProductCard product={p} eager={i < 4} index={i} headingLevel="h2" />
            </li>
          ))
        }
      </ul>

      <div class="py-24 text-center" data-empty hidden>
        <p class="text-[1.125rem] font-semibold">No hay prendas con estos filtros</p>
        <p class="mx-auto mt-2 max-w-sm text-ink-muted">
          Probá sacando algún talle o color, o subí el precio máximo.
        </p>
        <button type="button" class="btn btn-secondary mt-6" data-filters-clear>Limpiar filtros</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { onPage } from '../../lib/client/lifecycle';
  import { trapFocus } from '../../lib/client/focus-trap';
  import { formatPrice } from '../../config/site';

  const countLabel = (n: number) => (n === 1 ? '1 producto' : `${n} productos`);

  onPage(() => {
    const root = document.querySelector<HTMLElement>('[data-catalog]');
    if (!root) return;

    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const items = [...grid.querySelectorAll<HTMLElement>('[data-item]')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.chip[data-category]')];
    const form = root.querySelector<HTMLFormElement>('[data-filter-form]')!;
    const sort = root.querySelector<HTMLSelectElement>('[data-sort]')!;
    const price = root.querySelector<HTMLInputElement>('[data-price]')!;
    const priceOut = root.querySelector<HTMLOutputElement>('[data-price-output]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const applyCount = root.querySelector<HTMLElement>('[data-apply-count]')!;
    const activeCount = root.querySelector<HTMLElement>('[data-active-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const panel = root.querySelector<HTMLElement>('[data-filters]')!;
    const backdrop = root.querySelector<HTMLElement>('[data-filters-backdrop]')!;
    const openBtn = root.querySelector<HTMLButtonElement>('[data-filters-open]')!;
    const maxPrice = Number(root.dataset.maxPrice);
    const validSorts = [...sort.options].map((o) => o.value);
    const validCategories = chips.map((c) => c.dataset.category ?? '');

    let category = '';

    const checked = (name: string) =>
      [...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((i) => i.value);

    function readUrl() {
      const params = new URLSearchParams(location.search);
      const cat = params.get('categoria') ?? '';
      category = validCategories.includes(cat) ? cat : '';
      const sizes = (params.get('talle') ?? '').split(',').filter(Boolean);
      const colors = (params.get('color') ?? '').split(',').filter(Boolean);
      form.querySelectorAll<HTMLInputElement>('input[name="talle"]').forEach((i) => {
        i.checked = sizes.includes(i.value);
      });
      form.querySelectorAll<HTMLInputElement>('input[name="color"]').forEach((i) => {
        i.checked = colors.includes(i.value);
      });
      const max = Number(params.get('precio'));
      price.value = String(Number.isFinite(max) && max > 0 ? max : maxPrice);
      const order = params.get('orden') ?? '';
      sort.value = validSorts.includes(order) ? order : validSorts[0];
    }

    function writeUrl(sizes: string[], colors: string[], max: number) {
      const params = new URLSearchParams(location.search);
      const set = (key: string, value: string) => (value ? params.set(key, value) : params.delete(key));
      set('categoria', category);
      set('talle', sizes.join(','));
      set('color', colors.join(','));
      set('precio', max < maxPrice ? String(max) : '');
      set('orden', sort.value === validSorts[0] ? '' : sort.value);
      const query = params.toString();
      history.replaceState(history.state, '', `${location.pathname}${query ? `?${query}` : ''}`);
    }

    function apply() {
      const sizes = checked('talle');
      const colors = checked('color');
      const max = Number(price.value);
      priceOut.textContent = formatPrice(max);

      chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.category === category)));
      const activeChip = chips.find((chip) => chip.dataset.category === category);
      const chipRow = activeChip?.parentElement;
      if (activeChip && chipRow && chipRow.scrollWidth > chipRow.clientWidth) {
        const left = activeChip.offsetLeft - chipRow.offsetLeft;
        if (left < chipRow.scrollLeft || left + activeChip.offsetWidth > chipRow.scrollLeft + chipRow.clientWidth) {
          chipRow.scrollLeft = left - 16;
        }
      }

      let visible = 0;
      for (const item of items) {
        const itemSizes = (item.dataset.sizes ?? '').split(',');
        const itemColors = (item.dataset.colors ?? '').split('|');
        const show =
          (!category || item.dataset.category === category) &&
          (!sizes.length || sizes.some((s) => itemSizes.includes(s))) &&
          (!colors.length || colors.some((c) => itemColors.includes(c))) &&
          Number(item.dataset.price) <= max;
        item.hidden = !show;
        if (show) visible++;
      }

      const num = (el: HTMLElement, key: string) => Number(el.dataset[key]);
      const ordered = [...items].sort((a, b) => {
        switch (sort.value) {
          case 'nuevos':
            return num(b, 'published') - num(a, 'published');
          case 'precio-asc':
            return num(a, 'price') - num(b, 'price');
          case 'precio-desc':
            return num(b, 'price') - num(a, 'price');
          default:
            return num(a, 'index') - num(b, 'index');
        }
      });
      grid.append(...ordered);

      count.textContent = countLabel(visible);
      applyCount.textContent = countLabel(visible);
      empty.hidden = visible > 0;
      const active = sizes.length + colors.length + (max < maxPrice ? 1 : 0);
      activeCount.textContent = active ? `(${active})` : '';
      writeUrl(sizes, colors, max);
    }

    // Mobile bottom sheet.
    let release: (() => void) | null = null;
    const closeSheet = () => {
      if (!panel.hasAttribute('data-open')) return;
      panel.removeAttribute('data-open');
      panel.removeAttribute('role');
      panel.removeAttribute('aria-modal');
      backdrop.removeAttribute('data-open');
      openBtn.setAttribute('aria-expanded', 'false');
      release?.();
      release = null;
    };
    const openSheet = () => {
      panel.setAttribute('data-open', '');
      panel.setAttribute('role', 'dialog');
      panel.setAttribute('aria-modal', 'true');
      backdrop.setAttribute('data-open', '');
      openBtn.setAttribute('aria-expanded', 'true');
      release = trapFocus(panel, closeSheet);
    };
    const desktop = window.matchMedia('(min-width: 1024px)');
    const onBreakpoint = () => {
      if (desktop.matches) closeSheet();
    };

    const onChip = (event: Event) => {
      const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('.chip[data-category]');
      if (!chip) return;
      category = chip.dataset.category ?? '';
      apply();
    };
    const onReset = () => requestAnimationFrame(() => {
      price.value = String(maxPrice);
      apply();
    });
    const onClear = () => {
      form.reset();
      category = '';
      onReset();
    };
    const onRootClick = (event: Event) => {
      const target = event.target as HTMLElement;
      if (target.closest('[data-filters-open]')) openSheet();
      else if (target.closest('[data-filters-close], [data-filters-apply], [data-filters-backdrop]')) closeSheet();
      else if (target.closest('[data-filters-clear]')) onClear();
      else onChip(event);
    };

    readUrl();
    apply();

    root.addEventListener('click', onRootClick);
    form.addEventListener('input', apply);
    form.addEventListener('reset', onReset);
    sort.addEventListener('change', apply);
    desktop.addEventListener('change', onBreakpoint);

    return () => {
      closeSheet();
      root.removeEventListener('click', onRootClick);
      form.removeEventListener('input', apply);
      form.removeEventListener('reset', onReset);
      sort.removeEventListener('change', apply);
      desktop.removeEventListener('change', onBreakpoint);
    };
  });
</script>

<style>
  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 0.5rem;
  }

  @media (min-width: 1024px) {
    .catalog-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem 0.75rem;
    }
  }

  @media (min-width: 1536px) {
    .catalog-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .sort {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .sort select {
    appearance: none;
    min-height: 2.75rem;
    padding: 0 1.75rem 0 0.75rem;
    background: transparent;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
  }

  .sort :global(svg) {
    position: absolute;
    right: 0.25rem;
  }

  .color-check {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .color-check input {
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
  }

  .dot {
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: var(--swatch);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ink) 22%, transparent);
  }

  .range {
    width: 100%;
    height: 2.75rem;
    cursor: pointer;
  }

  .filters-body {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .filters-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .filters-close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.75rem;
    cursor: pointer;
  }

  .filters-backdrop {
    display: none;
  }

  /* Mobile: bottom sheet. */
  @media (max-width: 1023.98px) {
    .filters {
      position: fixed;
      z-index: 70;
      inset: auto 0 0 0;
      max-height: 85dvh;
      display: flex;
      flex-direction: column;
      background: var(--color-bg);
      box-shadow: var(--shadow-overlay);
      border-radius: 0.5rem 0.5rem 0 0;
      transform: translateY(100%);
      visibility: hidden;
      transition:
        transform 450ms var(--ease-out-expo),
        visibility 0s linear 450ms;
    }

    .filters[data-open] {
      transform: none;
      visibility: visible;
      transition-delay: 0s;
    }

    .filters-head {
      padding: 0.75rem var(--gutter);
      border-bottom: 1px solid var(--color-line);
    }

    .filters-body {
      flex: 1;
      overflow-y: auto;
      padding: 1.5rem var(--gutter);
    }

    .filters-foot {
      padding: 0.75rem var(--gutter) calc(0.75rem + env(safe-area-inset-bottom));
      border-top: 1px solid var(--color-line);
    }

    .filters-backdrop {
      display: block;
      position: fixed;
      z-index: 69;
      inset: 0;
      background: color-mix(in srgb, var(--color-ink) 40%, transparent);
      opacity: 0;
      pointer-events: none;
      transition: opacity 450ms var(--ease-out-expo);
    }

    .filters-backdrop[data-open] {
      opacity: 1;
      pointer-events: auto;
    }
  }

  /* Desktop: left filter column on surface. */
  @media (min-width: 1024px) {
    .filters-close,
    .filters-foot {
      display: none;
    }
    .filters {
      align-self: start;
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
      padding: 1.5rem;
      background: var(--color-surface);
    }
    .filters-body {
      margin-top: 1.5rem;
    }
  }
</style>
