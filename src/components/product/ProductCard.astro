---
import { Picture } from 'astro:assets';
import { formatPrice } from '../../config/site';
import {
  discountPercent,
  photoTransitionName,
  productHref,
  toCartPayload,
  type Product,
} from '../../lib/products';

interface Props {
  product: Product;
  /** Load eagerly (first row of a grid). */
  eager?: boolean;
  sizes?: string;
  /** Position used to stagger the reveal. */
  index?: number;
  headingLevel?: 'h2' | 'h3';
}

const {
  product,
  eager = false,
  sizes = '(min-width: 1536px) 24vw, (min-width: 1024px) 30vw, 50vw',
  index = 0,
  headingLevel: Heading = 'h3',
} = Astro.props;

const { data } = product;
const href = productHref(product);
const [primary, secondary] = data.images;
const discount = discountPercent(product);
const payload = await toCartPayload(product);
const inStock = data.sizes.filter((s) => s.inStock);
const widths = [320, 480, 640, 800];
---

<article class="card reveal" style={`--i:${index % 4}`} data-product={JSON.stringify(payload)}>
  <a
    href={href}
    class="card-media"
    tabindex="-1"
    aria-hidden="true"
    transition:name={photoTransitionName(product)}
  >
    <Picture
      src={primary.src}
      alt={primary.alt}
      widths={widths}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class="card-img"
    />
    {
      secondary && (
        <Picture
          src={secondary.src}
          alt=""
          widths={widths}
          sizes={sizes}
          formats={['avif', 'webp']}
          loading="lazy"
          class="card-img card-img-alt"
        />
      )
    }
  </a>

  {
    (data.isNew || discount) && (
      <div class="card-badges">
        {data.isNew && <span class="badge">Nuevo</span>}
        {discount && <span class="badge badge-sale">-{discount}%</span>}
      </div>
    )
  }

  <div class="card-body">
    <Heading class="card-name">
      <a href={href} class="card-link">{data.name}</a>
    </Heading>
    <p class="card-price">
      <span class:list={[discount && 'text-sale']}>
        <span class="sr-only">{discount ? 'Precio de oferta: ' : 'Precio: '}</span>
        {formatPrice(data.price)}
      </span>
      {
        data.compareAtPrice && discount && (
          <s class="text-ink-muted">
            <span class="sr-only">Precio anterior: </span>
            {formatPrice(data.compareAtPrice)}
          </s>
        )
      }
    </p>
    <ul class="card-sizes" aria-label="Talles">
      {
        data.sizes.map((s) =>
          s.inStock ? (
            <li>{s.label}</li>
          ) : (
            <li>
              <s class="text-ink-muted">{s.label}</s>
              <span class="sr-only"> (sin stock)</span>
            </li>
          ),
        )
      }
    </ul>
    <ul class="card-colors" aria-label={`Colores: ${data.colors.map((c) => c.name).join(', ')}`}>
      {data.colors.map((c) => <li style={`--swatch:${c.hex}`} title={c.name} />)}
    </ul>
  </div>

  {
    inStock.length > 0 && (
      <div class="quick-add" role="group" aria-label={`Agregar rápido ${data.name}`}>
        <p class="label">Agregar rápido</p>
        <div class="quick-sizes">
          {data.sizes.map((s) => (
            <button
              type="button"
              class="quick-size"
              data-quick-add
              data-size={s.label}
              disabled={!s.inStock}
              aria-label={
                s.inStock
                  ? `Agregar talle ${s.label} al carrito`
                  : `Talle ${s.label} sin stock`
              }
            >
              {s.label}
            </button>
          ))}
        </div>
      </div>
    )
  }
</article>

<style>
  /* Photo, badges and quick-add share the first grid cell. */
  .card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
  }

  .card-media {
    grid-area: 1 / 1;
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface);
  }

  .card-media :global(.card-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-media :global(.card-img-alt) {
    opacity: 0;
    transition: opacity 500ms var(--ease-out-expo);
  }

  .card-badges {
    grid-area: 1 / 1;
    align-self: start;
    justify-self: start;
    position: relative;
    z-index: 2;
    margin: 0.5rem;
    display: flex;
    gap: 0.25rem;
    pointer-events: none;
  }

  .card-body {
    grid-area: 2 / 1;
    padding: 0.75rem 0.125rem 0;
    display: grid;
    gap: 0.25rem;
  }

  .card-name {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.35;
  }

  /* The whole card photo + name is one target for pointer users. */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card-link:focus-visible {
    outline: none;
  }

  .card-link:focus-visible::after {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
  }

  .card-price {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .card-sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.125rem;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .card-colors {
    display: flex;
    gap: 0.375rem;
    margin-top: 0.25rem;
  }

  .card-colors li {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
    background: var(--swatch);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ink) 22%, transparent);
  }

  .quick-add {
    display: none;
  }

  @media (hover: hover) {
    .card:hover :global(.card-img-alt) {
      opacity: 1;
    }

    .quick-add {
      grid-area: 1 / 1;
      align-self: end;
      position: relative;
      z-index: 2;
      margin: 0.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding: 0.75rem;
      background: var(--color-bg);
      opacity: 0;
      visibility: hidden;
      transform: translateY(8px);
      transition:
        opacity 300ms var(--ease-out-expo),
        transform 300ms var(--ease-out-expo),
        visibility 0s linear 300ms;
    }

    .card:hover .quick-add,
    .card:focus-within .quick-add {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }
  }

  .quick-sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .quick-size {
    flex: 1 0 2.75rem;
    min-height: 2.75rem;
    border: 1px solid var(--color-line);
    border-radius: 2px;
    font-size: 0.75rem;
    font-weight: 500;
    background: var(--color-bg);
    cursor: pointer;
    transition:
      background-color 200ms var(--ease-out-expo),
      color 200ms var(--ease-out-expo);
  }

  .quick-size:disabled {
    color: var(--color-ink-muted);
    text-decoration: line-through;
    background: var(--color-surface);
    border-color: var(--color-surface);
    cursor: not-allowed;
  }

  .quick-size:not(:disabled):hover {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-on-ink);
  }
</style>
