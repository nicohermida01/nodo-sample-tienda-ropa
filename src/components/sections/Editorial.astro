---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../../config/site';

interface Props {
  image: { src: ImageMetadata; alt: string };
}

const { image } = Astro.props;
const { title, text, cta } = site.copy.home.editorial;
---

<section class="bg-surface" aria-labelledby="editorial-title">
  <div class="grid items-center lg:grid-cols-2">
    <div class="editorial-media reveal">
      <Picture
        src={image.src}
        alt={image.alt}
        widths={[480, 720, 960, 1200]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        formats={['avif', 'webp']}
        loading="lazy"
        class="h-full w-full object-cover"
      />
    </div>
    <div class="px-[var(--gutter)] py-20 lg:px-16 lg:py-32 xl:px-24">
      <div class="reveal max-w-[34rem]" style="--i:1">
        <h2 id="editorial-title" class="text-[2rem] leading-[1.1] font-semibold tracking-[-0.02em] lg:text-[2.75rem]">
          {title}
        </h2>
        <p class="mt-6 text-[1.25rem] leading-snug font-medium tracking-[-0.01em] lg:text-[1.375rem]">
          {site.brand.description}
        </p>
        <p class="mt-5 text-[1rem] leading-relaxed text-ink-muted">{text}</p>
        <a href={cta.href} class="btn btn-secondary mt-10">{cta.label}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .editorial-media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-ink);
  }

  @media (min-width: 1024px) {
    .editorial-media {
      aspect-ratio: auto;
      height: 100%;
      min-height: 44rem;
    }
  }
</style>
