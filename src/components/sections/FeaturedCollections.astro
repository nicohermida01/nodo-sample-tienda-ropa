---
import { Picture } from 'astro:assets';
import { site } from '../../config/site';
import type { ProductCollection } from '../../lib/products';

interface Props {
  collections: ProductCollection[];
}

const { collections } = Astro.props;
---

<section class="bleed pt-16 lg:pt-24" aria-labelledby="collections-title">
  <h2 id="collections-title" class="section-title">{site.copy.home.collectionsTitle}</h2>
  <ul class="mt-8 grid gap-2 md:grid-cols-2 lg:mt-10 lg:gap-3">
    {
      collections.map((c, i) => (
        <li class="reveal" style={`--i:${i}`}>
          <a href={`/colecciones/${c.data.slug}`} class="cover on-photo">
            <Picture
              src={c.data.cover.src}
              alt={c.data.cover.alt}
              widths={[480, 720, 960, 1200]}
              sizes="(min-width: 768px) 50vw, 100vw"
              formats={['avif', 'webp']}
              loading="lazy"
              class="cover-img"
            />
            <span class="cover-scrim" aria-hidden="true" />
            <span class="cover-text">
              <span class="cover-name">{c.data.name}</span>
              {c.data.coverLine && <span class="cover-tagline">{c.data.coverLine}</span>}
              <span class="btn-pill mt-6">Ver colección</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cover {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    color: var(--color-on-ink);
    background: var(--color-surface);
  }

  .cover :global(.cover-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out-expo);
  }

  .cover-scrim {
    position: absolute;
    inset: 0;
    background: var(--scrim);
  }

  .cover-text {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2.5rem 1.5rem;
  }

  .cover-name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  .cover-tagline {
    margin-top: 0.75rem;
    max-width: 32ch;
    font-size: 0.9375rem;
  }

  @media (hover: hover) {
    .cover:hover :global(.cover-img) {
      transform: scale(1.03);
    }
    .cover:hover .btn-pill {
      background: transparent;
      color: var(--color-on-ink);
    }
  }
</style>
